# tMai Chain Environment Variables
# 已配置用于 BSC Testnet 部署

# ============================================
# Network Configuration
# ============================================
L1_NETWORK=bsc_testnet
L1_CHAIN_ID=97
L1_RPC_URL=http://13.212.114.138:10575
L1_WS_URL=ws://13.212.114.138:10576

# ============================================
# Base Token Configuration
# ============================================
# Testnet tMai
BASE_TOKEN_ADDRESS=0xC42F240C256F5FB97346b9d69d10E2e1D77b2EBa
BASE_TOKEN_NOMINATOR=1
BASE_TOKEN_DENOMINATOR=1

# ============================================
# Chain Configuration
# ============================================
CHAIN_NAME=tmai_chain
CHAIN_ID=9720
L2_CHAIN_ID=9720

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgres://postgres:notsecurepassword@localhost:5432/tmai_chain
DATABASE_PROVER_URL=postgres://postgres:notsecurepassword@localhost:5432/tmai_chain_prover

# ============================================
# API Configuration
# ============================================
API_WEB3_JSON_RPC_HTTP_PORT=3050
API_WEB3_JSON_RPC_WS_PORT=3051
API_PROMETHEUS_PORT=3312
API_HEALTHCHECK_PORT=3081

# API URLs
API_WEB3_JSON_RPC_HTTP_URL=http://0.0.0.0:3050
API_WEB3_JSON_RPC_WS_URL=ws://0.0.0.0:3051

# ============================================
# Wallet Private Keys
# ============================================
# L1 Address: 0x7CB5c1C44f7729a34F07Bb67603d65D81a8cD16a

# Operator wallet (sends L1 transactions)
OPERATOR_PRIVATE_KEY=0xc9fd9d8eedf1d07a3ff46bd7370c48db3b4c359f4d0dfd73404c3a27f687dae1

# Governor wallet (governance operations)
GOVERNOR_PRIVATE_KEY=0xc9fd9d8eedf1d07a3ff46bd7370c48db3b4c359f4d0dfd73404c3a27f687dae1

# Deployer wallet (contract deployment)
DEPLOYER_PRIVATE_KEY=0xc9fd9d8eedf1d07a3ff46bd7370c48db3b4c359f4d0dfd73404c3a27f687dae1

# Fee account (receives transaction fees)
FEE_ACCOUNT_ADDRESS=0x7CB5c1C44f7729a34F07Bb67603d65D81a8cD16a

# ============================================
# Gas Configuration
# ============================================
ETH_SENDER_GAS_ADJUSTER_MIN_BASE_FEE=100000000
ETH_SENDER_GAS_ADJUSTER_MAX_BASE_FEE=5000000000
ETH_SENDER_GAS_ADJUSTER_DEFAULT_PRIORITY_FEE=100000000
ETH_SENDER_GAS_ADJUSTER_MAX_PRIORITY_FEE=1000000000

# Gas adjuster settings
ETH_SENDER_GAS_ADJUSTER_NUM_SAMPLES=10
ETH_SENDER_GAS_ADJUSTER_INTERNAL_L1_PRICING_MULTIPLIER=0.8
ETH_SENDER_GAS_ADJUSTER_POLL_PERIOD=15

# ============================================
# State Keeper Configuration
# ============================================
STATE_KEEPER_TRANSACTION_SLOTS=8192
STATE_KEEPER_BLOCK_COMMIT_DEADLINE_MS=2500
STATE_KEEPER_MINIBLOCK_COMMIT_DEADLINE_MS=1000
STATE_KEEPER_MAX_SINGLE_TX_GAS=15000000

# ============================================
# Mempool Configuration
# ============================================
MEMPOOL_DELAY_INTERVAL=100
MEMPOOL_SYNC_INTERVAL_MS=10
MEMPOOL_CAPACITY=10000000
MEMPOOL_STUCK_TX_TIMEOUT=86400
MEMPOOL_REMOVE_STUCK_TXS=true

# ============================================
# Fee Model Configuration
# ============================================
FEE_MODEL_MINIMAL_L2_GAS_PRICE=250000000
FEE_MODEL_COMPUTE_OVERHEAD_PART=0.0
FEE_MODEL_PUBDATA_OVERHEAD_PART=1.0
FEE_MODEL_BATCH_OVERHEAD_L1_GAS=800000
FEE_MODEL_MAX_GAS_PER_BATCH=200000000
FEE_MODEL_MAX_PUBDATA_PER_BATCH=120000

# ============================================
# Prover Configuration
# ============================================
PROVER_VERSION=gpu
PROVER_SETUP_DATA_PATH=./prover/data/keys

# ============================================
# Logging Configuration
# ============================================
RUST_LOG=info,zksync_core=debug,zksync_eth_sender=debug
RUST_BACKTRACE=1
RUST_LOG_FORMAT=json

# ============================================
# Observability
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============================================
# Object Store Configuration
# ============================================
OBJECT_STORE_MODE=FileBacked
OBJECT_STORE_FILE_BACKED_BASE_PATH=./artifacts

# ============================================
# Misc Configuration
# ============================================
ZKSYNC_HOME=/path/to/zksync-era
WALLET_CREATION=localhost
L1_BATCH_COMMIT_DATA_GENERATOR_MODE=rollup
